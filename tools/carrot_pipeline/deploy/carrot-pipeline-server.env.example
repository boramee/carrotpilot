# Copy to: /etc/default/carrot-pipeline-server

# Absolute path to repository root
OPENPILOT_DIR=/workspace

# Server bind
BIND_ADDR=0.0.0.0
PORT=9090

# Upload auth token (must match client token)
UPLOAD_TOKEN=CHANGE_ME_UPLOAD_TOKEN

# Storage path for uploaded logs and analysis results
STORAGE_ROOT=/tmp/carrot_pipeline
MIN_SPEED=8.0
MAX_UPLOAD_MB=512

# Telegram settings
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_CHAT_ID
