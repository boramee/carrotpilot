# Copy to: /etc/default/carrot-upload-client

# Absolute path to repository root on device
OPENPILOT_DIR=/data/openpilot

# Pipeline server
SERVER_URL=https://CHANGE_ME_SERVER:9090
UPLOAD_TOKEN=CHANGE_ME_UPLOAD_TOKEN

# Set to --include-rlog or empty
INCLUDE_RLOG_FLAG=--include-rlog

# Polling and upload behavior
POLL_SEC=10
SETTLE_SEC=90

# Device log path and state file
LOG_ROOT=/data/media/0/realdata
STATE_FILE=/data/media/0/realdata/carrot_upload_state.json
